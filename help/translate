# script to package files for translation by Claude

cat >/tmp/xx <<EOF
German de
French fr
Armenian hy
Russian ru
Ukrainian uk
EOF

# remove the developer stuff fron the index
sed -i -e '/developer.index/d' en/index.rst

# convert the files
cat /tmp/xx | while read lang code; do
    echo $code
    f=en-$code.zip
    rm -f $f
    zip $f en/*.rst ../locale/$code/LC_MESSAGES/*.po >/dev/null
    cat <<EOF
translate the .rst files in $f to $lang, preserving the .rst
markup. The existing $lang translations for UI labels are in the .po
files. List any UI labels without an existing translation. Produce an
output .zip file with the translated .rst files.

EOF
done

# restore the en/index
git restore en/index.rst

