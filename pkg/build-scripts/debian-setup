#!/usr/bin/env bash

# mostly generated by Google Gemini from .github/workflows/ubuntu-release.yml
# this should install everything needed by debian-build
# on a stock Ubuntu 26.04 LTS system.

set -euo pipefail

echo "=== 1. Update APT package index ==="
sudo apt-get update

echo "=== 2. Install base CLI, Python, and .deb packaging tools ==="
# Includes git, jq, and python3-pip which are pre-installed on GitHub runners
# but often missing on a stock Ubuntu 26 workstation.
sudo apt-get install -y \
  git \
  curl \
  ca-certificates \
  python3 \
  python3-pip \
  python3-all-dev

echo "=== Setup complete! ==="
echo "All system and Python dependencies are installed."
