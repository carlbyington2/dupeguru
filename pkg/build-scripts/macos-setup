#!/usr/bin/env bash

# mostly generated by Google Gemini from .github/workflows/macos-release.yml
# this should install everything needed by macos-build
# on a stock macOS Tahoe 26 system

set -euo pipefail

echo "=== 1. Ensure Xcode Command Line Tools are installed ==="
if ! xcode-select -p &>/dev/null; then
  echo "Xcode Command Line Tools not found. Triggering installer..."
  xcode-select --install
  echo "Please complete the Xcode Command Line Tools installation prompt, then re-run this script."
  exit 1
else
  echo "Xcode Command Line Tools already installed at: $(xcode-select -p)"
fi

echo "=== 2. Ensure Homebrew is installed and loaded ==="
if [ -x "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x "/usr/local/bin/brew" ]; then
  eval "$(/usr/local/bin/brew shellenv)"
else
  echo "Homebrew not found. Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://githubusercontent.com)"
  if [ -x "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x "/usr/local/bin/brew" ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

echo "=== 3. Install Homebrew system dependencies ==="
# Includes python@3.13 (or latest brew python3) because stock macOS lacks a standalone Python 3
# until Xcode CLT is installed, and Homebrew Python avoids Apple's older framework quirks.
brew update
brew install python git gettext coreutils
brew link --force gettext

echo "=== Setup complete! ==="
echo "All macOS 26 system and Python dependencies are installed."
