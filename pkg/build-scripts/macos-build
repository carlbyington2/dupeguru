#!/usr/bin/env bash

# generated by Google Gemini from .github/workflows/macos-release.yml
# this modifies some repository files in place
# it also updates your system with the packaged application

set -euo pipefail

# Ensure script is run from the root of the repository
if [ ! -f "build.py" ] || [ ! -f "package.py" ] || [ ! -f "dupeguru/core/__init__.py" ]; then
  echo "Error: Please run this script from the root directory of the dupeguru repository."
  exit 1
fi

# Ensure Homebrew is on PATH (supports both Apple Silicon and Intel Macs)
if [ -x "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x "/usr/local/bin/brew" ]; then
  eval "$(/usr/local/bin/brew shellenv)"
else
  echo "Error: Homebrew is not installed. Please install Homebrew first: https://brew.sh"
  exit 1
fi

echo "=== 1. Update full version to {ver}+{date}git{hash}.macos ==="
VERSION_OUTPUT=$(python3 - << 'EOF'
import re, subprocess
from datetime import datetime, timezone
from pathlib import Path

path = Path("dupeguru/core/__init__.py")
text = path.read_text(encoding="utf-8")

match = re.search(r'^__version__\s*=\s*["\']([^"\']+)["\']', text, re.MULTILINE)
version = match.group(1)
build_date = datetime.now(timezone.utc).strftime("%Y%m%d")
short_sha = subprocess.check_output(["git", "rev-parse", "--short", "HEAD"], text=True).strip()
new_full_version = f"{version}+{build_date}git{short_sha}.macos"

updated_text = re.sub(
    r'^(__full_version__\s*=\s*)["\'][^"\']+["\']',
    rf'\g<1>"{new_full_version}"',
    text,
    flags=re.MULTILINE,
)
path.write_text(updated_text, encoding="utf-8")

print(f"{version}|{new_full_version}")
EOF
)

IFS='|' read -r VERSION FULL_VERSION <<< "$VERSION_OUTPUT"
echo "Detected version: $VERSION"
echo "Full build version: $FULL_VERSION"

echo "=== 2. Install system dependencies via Homebrew ==="
brew update
brew install gettext coreutils
brew link --force gettext

echo "=== 3. Set up virtual environment ==="
rm -rf /tmp/.venv
python3 -m venv /tmp/.venv
export PATH="/tmp/.venv/bin:$PATH"

echo "=== 4. Install Python build and packaging dependencies ==="
python -m pip install --upgrade pip
python -m pip install --only-binary :all: -r requirements.txt -r requirements-extra.txt PySide6-Essentials

echo "=== 5. Check feature formatting and lint ==="
python -m black --check .
python -m flake8

echo "=== 6. Build application ==="
python build.py --clean
echo "*** Remove build-only PySide6 so PyInstaller only bundles PyQt6"
python -m pip uninstall -y PySide6-Essentials shiboken6

echo "=== 7. Run core and Qt regression tests ==="
python -m pytest dupeguru

echo "=== 8. Package to macOS bundle/archive ==="
python package.py

echo "=== 9. Build the dmg file from the bundle ==="
hdiutil create -volname "dupeGuru" -srcfolder dist/dupeguru.app -ov -format UDZO dist/dupeguru.dmg

echo "=== 10. Prepare packaged app for smoke tests ==="
rm -rf /Applications/dupeguru.app
cp -R dist/dupeguru.app /Applications/
ls -al /Applications/dupeguru.app/Contents/MacOS/
echo "*** Inspect the binary app"
echo "q" | pyi-archive_viewer dist/dupeguru.app/Contents/MacOS/dupeguru

echo "=== 11. Smoke test 1: 5-second survival ==="
(
  APP_BIN="/Applications/dupeguru.app/Contents/MacOS/dupeguru"
  LOG_FILE="$HOME/Library/Application Support/Hardcoded Software/dupeGuru/debug.log"

  cleanup() {
    if [ -n "${PID:-}" ]; then
      kill -TERM "$PID" 2>/dev/null || true
      wait "$PID" 2>/dev/null || true
      for _ in $(seq 1 50); do
        kill -0 "$PID" 2>/dev/null || break
        sleep 0.1
      done
      kill -KILL "$PID" 2>/dev/null || true
    fi
    if [ -f "$LOG_FILE" ]; then
      cat "$LOG_FILE"
    fi
  }
  trap cleanup EXIT

  "$APP_BIN" &
  PID=$!

  sleep 5
  if ! kill -0 "$PID" 2>/dev/null; then
    wait "$PID" || EXIT_CODE=$?
    echo "Packaged application exited prematurely with code: ${EXIT_CODE:-unknown}"
    exit 1
  fi
  echo "Packaged Qt application started and is running cleanly (PID: $PID)"
)

echo "=== 12. Smoke test 2: --smoke-test flag ==="
(
  APP_BIN="/Applications/dupeguru.app/Contents/MacOS/dupeguru"
  LOG_FILE="$HOME/Library/Application Support/Hardcoded Software/dupeGuru/debug.log"

  print_log() {
    if [ -f "$LOG_FILE" ]; then
      cat "$LOG_FILE"
    fi
  }
  trap print_log EXIT

  set +e
  gtimeout --kill-after=5s 10s "$APP_BIN" --smoke-test
  EXIT_CODE=$?
  set -e

  if [ "$EXIT_CODE" -eq 124 ] || [ "$EXIT_CODE" -eq 137 ]; then
    echo "Packaged application startup timed out"
    exit 1
  elif [ "$EXIT_CODE" -ne 0 ]; then
    echo "Packaged application failed with exit code: $EXIT_CODE"
    exit "$EXIT_CODE"
  fi
  echo "Packaged Qt application initialized and exited successfully"
)

echo "=== 13. Collect build artifacts (Replaces upload-artifact) ==="
ARCH=$(uname -m)
ARTIFACT_DIR="dist/dupeguru.${FULL_VERSION}.${ARCH}"
rm -rf "$ARTIFACT_DIR"
mkdir -p "$ARTIFACT_DIR"

if [ ! -d "dist/dupeguru.app" ] || [ ! -f "dist/dupeguru.dmg" ]; then
  echo "Error: Expected build artifacts (dist/dupeguru.app or dist/dupeguru.dmg) not found."
  exit 1
fi

cp -R dist/dupeguru.app "$ARTIFACT_DIR/"
cp dist/dupeguru.dmg "$ARTIFACT_DIR/"

echo "Build complete! Artifacts saved to: $ARTIFACT_DIR"
ls -lh "$ARTIFACT_DIR"
