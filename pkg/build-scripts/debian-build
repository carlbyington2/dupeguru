#!/usr/bin/env bash

# generated by Google Gemini from .github/workflows/ubuntu-release.yml
# this modifies some repository files in place
# it also updates your system with the packaged application

set -euo pipefail

# Ensure script is run from the root of the repository
if [ ! -f "pkg/debian/control" ] || [ ! -f "build.py" ]; then
  echo "Error: Please run this script from the root directory of the repository."
  exit 1
fi

echo "=== 1. Install .deb packaging dependencies ==="
sudo apt-get update
sudo apt-get install -y \
  jq \
  xvfb \
  pyside6-tools \
  python3-venv \
  python3-setuptools \
  build-essential \
  debhelper \
  dpkg-dev \
  devscripts \
  fakeroot \
  python3-all-dev \
  gettext \
  equivs

echo "=== 2. Update pkg/debian/control ==="
# Equivalent to package_debian_distribution() in package.py;
# needed here before mk-build-deps runs.
JSON_FILE="pkg/debian/dupeguru.json"
TARGET_FILE="pkg/debian/control"

jq -r 'to_entries[] | "\(.key)\t\(.value)"' "$JSON_FILE" | while IFS=$'\t' read -r key value; do
  # Escape characters in the replacement value that might break sed (&, \, |)
  escaped_val=$(printf '%s\n' "$value" | sed -e 's/[&\|]/\\&/g')
  # Replace {key} with its corresponding value
  sed -i "s|{$key}|$escaped_val|g" "$TARGET_FILE"
done

echo "=== 3. Update full version to {ver}+{date}git{hash}.ubuntu ==="
VERSION_OUTPUT=$(python3 - << 'EOF'
import re, subprocess
from datetime import datetime, timezone
from pathlib import Path

path = Path("dupeguru/core/__init__.py")
text = path.read_text(encoding="utf-8")

match = re.search(r'^__version__\s*=\s*["\']([^"\']+)["\']', text, re.MULTILINE)
version = match.group(1)
build_date = datetime.now(timezone.utc).strftime("%Y%m%d")
short_sha = subprocess.check_output(["git", "rev-parse", "--short", "HEAD"], text=True).strip()
new_full_version = f"{version}+{build_date}git{short_sha}.ubuntu"

updated_text = re.sub(
    r'^(__full_version__\s*=\s*)["\'][^"\']+["\']',
    rf'\g<1>"{new_full_version}"',
    text,
    flags=re.MULTILINE,
)
path.write_text(updated_text, encoding="utf-8")

print(f"{version}|{new_full_version}")
EOF
)

IFS='|' read -r VERSION FULL_VERSION <<< "$VERSION_OUTPUT"
echo "Detected version: $VERSION"
echo "Full build version: $FULL_VERSION"

echo "=== 4. Install dependencies from pkg/debian/control ==="
sudo mk-build-deps --install --remove --tool "apt-get -o Debug::pkgProblemResolver=yes --no-install-recommends --yes" pkg/debian/control

echo "=== 5. Set up virtual environment with system site-packages ==="
rm -rf /tmp/.venv
python3 -m venv --system-site-packages /tmp/.venv
export PATH="/tmp/.venv/bin:$PATH"

echo "=== 6. Install Python build dependencies ==="
python -m pip install --only-binary :all: -r requirements.txt -r requirements-extra.txt

echo "=== 7. Check feature formatting and lint ==="
python -m black --check .
python -m flake8

echo "=== 8. Build application ==="
python build.py --clean

echo "=== 9. Package to Ubuntu .deb file ==="
python package.py

echo "=== 10. Inspect generated .deb contents ==="
ls -al build/*.deb
dpkg-deb --info build/*.deb
dpkg-deb --contents build/*.deb

echo "=== 11. Install the .deb package for smoke tests ==="
sudo apt-get update
sudo apt-get install -y ./build/*.deb

echo "=== 12. Smoke test 1: 5-second survival ==="
(
  APP_BIN="/usr/bin/dupeguru"
  LOG_FILE="$HOME/.local/share/Hardcoded Software/dupeGuru/debug.log"

  cleanup() {
    if [ -n "${PID:-}" ]; then
      kill -TERM -"$PID" 2>/dev/null || true
      wait "$PID" 2>/dev/null || true
      for _ in $(seq 1 50); do
        kill -0 -"$PID" 2>/dev/null || break
        sleep 0.1
      done
      kill -KILL -"$PID" 2>/dev/null || true
    fi
    if [ -f "$LOG_FILE" ]; then
      cat "$LOG_FILE"
    fi
  }
  trap cleanup EXIT

  setsid xvfb-run -a "$APP_BIN" &
  PID=$!

  sleep 5
  if ! kill -0 "$PID" 2>/dev/null; then
    wait "$PID" || EXIT_CODE=$?
    echo "Packaged application exited prematurely with code: ${EXIT_CODE:-unknown}"
    exit 1
  fi
  echo "Packaged Qt application started and is running cleanly (PID: $PID)"
)

echo "=== 13. Smoke test 2: --smoke-test flag ==="
(
  APP_BIN="/usr/bin/dupeguru"
  LOG_FILE="$HOME/.local/share/Hardcoded Software/dupeGuru/debug.log"

  print_log() {
    if [ -f "$LOG_FILE" ]; then
      cat "$LOG_FILE"
    fi
  }
  trap print_log EXIT

  set +e
  timeout --kill-after=5s 10s xvfb-run -a "$APP_BIN" --smoke-test
  EXIT_CODE=$?
  set -e

  if [ "$EXIT_CODE" -eq 124 ] || [ "$EXIT_CODE" -eq 137 ]; then
    echo "Packaged application startup timed out"
    exit 1
  elif [ "$EXIT_CODE" -ne 0 ]; then
    echo "Packaged application failed with exit code: $EXIT_CODE"
    exit "$EXIT_CODE"
  fi
  echo "Packaged Qt application initialized and exited successfully"
)

echo "=== 14. Collect build artifacts (Replaces upload-artifact) ==="
ARTIFACT_DIR="dist/dupeguru.${FULL_VERSION}.amd64"
mkdir -p "$ARTIFACT_DIR"

shopt -s nullglob
FILES=(build/*.deb build/*.dsc build/*.tar.*)
if [ ${#FILES[@]} -eq 0 ]; then
  echo "Error: No build artifacts found in build/"
  exit 1
fi

cp "${FILES[@]}" "$ARTIFACT_DIR/"
echo "Build complete! Artifacts saved to: $ARTIFACT_DIR"
ls -lh "$ARTIFACT_DIR"
