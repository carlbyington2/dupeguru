#: dupeguru/core/app.py:44
msgid "There are no marked duplicates. Nothing has been done."
msgstr ""
"Không có phần đánh dấu nào trùng nhau. Vẫn chưa thực hiện thao tác nào."

#: dupeguru/core/app.py:45
msgid "There are no selected duplicates. Nothing has been done."
msgstr ""
"Không có phần đánh dấu nào trùng nhau. Vẫn chưa thực hiện thao tác nào."

#: dupeguru/core/app.py:46
msgid ""
"The file is not under any folder in the Directories panel. Can't recreate "
"relative path."
msgstr ""
"Tập tin không thuộc thư mục nào trong bảng Thư mục. Không thể tạo lại đường "
"dẫn tương đối."

#: dupeguru/core/app.py:47
msgid ""
"You're about to open many files at once. Depending on what those files are "
"opened with, doing so can create quite a mess. Continue?"
msgstr ""
"Bạn chuẩn bị mở nhiều tập tin cùng lúc. Dựa trên chương trình các tập tin "
"được mở, thao tác này có thể gây ra trạng thái lộn xộn. Vẫn muốn tiếp tục?"

#: dupeguru/core/app.py:51
msgid "{} of the {} marked files are reference files!"
msgstr "{} trong tổng số {} tệp đã đánh dấu là tệp tham chiếu!"

#: dupeguru/core/app.py:52
msgid "{} of the {} selected files are reference files!"
msgstr "{} trong số {} tệp đã chọn là tệp tham chiếu!"

#: dupeguru/core/app.py:53
msgid ""
"Deleted files can't be replaced with links while reference files are marked:"
" the links would point to files being deleted. Nothing has been done."
msgstr ""
"Không thể thay thế các tệp đã xóa bằng liên kết khi các tệp tham chiếu được "
"đánh dấu: các liên kết sẽ trỏ đến các tệp đang bị xóa. Không có gì được thực"
" hiện."

#: dupeguru/core/app.py:96
msgid "Scanning for duplicates"
msgstr "Quét các phần trùng nhau"

#: dupeguru/core/app.py:97
msgid "Loading"
msgstr "Đang tải"

#: dupeguru/core/app.py:98
msgid "Moving"
msgstr "Đang di chuyển"

#: dupeguru/core/app.py:99
msgid "Copying"
msgstr "Đang sao chép"

#: dupeguru/core/app.py:100
msgid "Sending to Trash"
msgstr "Đang gửi vào thùng rác"

#: dupeguru/core/app.py:317
msgid ""
"A previous action is still hanging in there. You can't start a new one yet. "
"Wait a few seconds, then try again."
msgstr ""
"Hiện đã có một tiến trình đang được tiến hành. Bạn không thể bắt đầu một "
"phần khác. Hãy đợi trong vài giây, và sau đó thử lại lần nữa."

#: dupeguru/core/app.py:328
msgid "No duplicates found."
msgstr "Không tìm thấy thành phần trùng nhau."

#: dupeguru/core/app.py:343
msgid "All marked files were copied successfully."
msgstr "Tất cả tập tin được đánh dấu đã được sao chép thành công."

#: dupeguru/core/app.py:345
msgid "All marked files were moved successfully."
msgstr "Tất cả các tập tin được đánh dấu đã được di chuyển thành công."

#: dupeguru/core/app.py:347
msgid "All marked files were deleted successfully."
msgstr "Tất cả các tập tin được đánh dấu đã được xóa thành công."

#: dupeguru/core/app.py:349
msgid "All marked files were successfully sent to Trash."
msgstr ""
"Tất cả các tập tin được đánh dấu đã được gửi đến Thùng Rác thành công."

#: dupeguru/core/app.py:354
msgid "Could not load file: {}"
msgstr "Không thể tải tệp: {}"

#: dupeguru/core/app.py:421
msgid "'{}' already is in the list."
msgstr "'{}' đã tồn tại trong danh sách."

#: dupeguru/core/app.py:424
msgid ""
"'{}' could not be read. It might be on a disconnected network share, or you "
"might not have the permission to access it."
msgstr ""
"Không thể đọc được '{}'. Tệp có thể nằm trên một chia sẻ mạng đã ngắt kết "
"nối hoặc bạn không có quyền truy cập vào tệp đó."

#: dupeguru/core/app.py:430
msgid "'{}' does not exist."
msgstr "'{}' không tồn tại."

#: dupeguru/core/app.py:438
msgid ""
"All selected %d matches are going to be ignored in all subsequent scans. "
"Continue?"
msgstr ""
"Các phần được chọn %d khớp với nhau sẽ được bỏ qua trong các lần quét sau. "
"Tiếp tục?"

#: dupeguru/core/app.py:522
msgid "Select a directory to copy marked files to"
msgstr ""
"Vui lòng chọn một thư mục mà bạn muốn sao chép các tệp đã đánh dấu vào"

#: dupeguru/core/app.py:524
msgid "Select a directory to move marked files to"
msgstr ""
"Vui lòng chọn một thư mục mà bạn muốn di chuyển các tệp đã đánh dấu đến"

#: dupeguru/core/app.py:570
msgid "Select a destination for your exported CSV"
msgstr "Chọn một điểm xuất dữ liệu dạng CSV"

#: dupeguru/core/app.py:576 dupeguru/core/app.py:846 dupeguru/core/app.py:856
msgid "Couldn't write to file: {}"
msgstr "Không thể ghi vào tệp: {}"

#: dupeguru/core/app.py:600
msgid "You have no custom command set up. Set it up in your preferences."
msgstr ""
"Bạn vẫn chưa chỉnh sửa phần thiết lập dòng lệnh. Hãy sử dụng tính năng này "
"trong phần tùy biến của bạn."

#: dupeguru/core/app.py:616
msgid "Invalid custom command syntax: {}"
msgstr "Cú pháp lệnh tùy chỉnh không hợp lệ: {}"

#: dupeguru/core/app.py:626
msgid "Failed to execute custom command: {}"
msgstr "Không thể thực thi lệnh tùy chỉnh: {}"

#: dupeguru/core/app.py:769 dupeguru/core/app.py:781
msgid "You are about to remove %d files from results. Continue?"
msgstr "Bạn chuẩn bị loại bỏ %d tập tin từ phần kết quả. Tiếp tục?"

#: dupeguru/core/app.py:818
msgid "{} duplicate groups were changed by the re-prioritization."
msgstr "{} các nhóm trùng nhau đã được thay đổi bởi thứ tự-tái ưu tiên."

#: dupeguru/core/app.py:866
msgid "The selected directories contain no scannable file."
msgstr "Các thứ mục được chọn chứa các tập tin không thể quét được."

#: dupeguru/core/app.py:882
msgid "Collecting files to scan"
msgstr "Đang thu thập các tập tin để quét"

#: dupeguru/core/app.py:948
msgid "%s (%d discarded)"
msgstr "%s (%d bị bỏ qua)"

#: dupeguru/core/directories.py:227
msgid "Collected {} files to scan"
msgstr "Đã thu thập {} tập tin để quét"

#: dupeguru/core/directories.py:243
msgid "Collected {} folders to scan"
msgstr "Đã thu thập {} thư mục để quét"

#: dupeguru/core/engine.py:27
msgid "%d matches found from %d groups"
msgstr "Tìm thấy %d trận đấu từ %d nhóm"

#: dupeguru/core/gui/deletion_options.py:71
msgid "You are sending {} file(s) to the Trash."
msgstr "Bạn sắp sửa gửi {} (các)tập tin đến Thùng Rác."

#: dupeguru/core/gui/exclude_list_table.py:14
msgid "Regular Expressions"
msgstr "Biểu thức chính quy"

#: dupeguru/core/gui/ignore_list_dialog.py:25
